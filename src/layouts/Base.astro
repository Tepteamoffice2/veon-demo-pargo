---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-rec="SEO-R04">{title}</title>
    <meta name="description" content={description} data-rec="SEO-R04" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" data-rec="SEO-R05" />
    <meta property="og:locale" content="uk_UA" data-rec="SEO-R05" />
    <meta property="og:site_name" content="ParGo" data-rec="SEO-R05" />
    <meta property="og:title" content={title} data-rec="SEO-R05" />
    <meta property="og:description" content={description} data-rec="SEO-R05" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#242424" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}images/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}images/apple-touch-icon.png`} />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

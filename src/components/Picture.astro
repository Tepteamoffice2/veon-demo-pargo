---
// Local responsive image: AVIF + WebP from public/images (generated from content/client-assets).
interface Props {
  base: string;            // "/images/name" without extension
  widths?: number[];       // variants "<base>-<w>.<ext>"; omit for a single file "<base>.<ext>"
  sizes?: string;
  width: number; height: number; alt: string;
  class?: string; loading?: "lazy" | "eager"; priority?: boolean;
}
const { base, widths, sizes, width, height, alt, class: cls, loading = "lazy", priority = false } = Astro.props;
const set = (ext: string) => widths ? widths.map((w) => `${base}-${w}.${ext} ${w}w`).join(", ") : `${base}.${ext}`;
const fallback = widths ? `${base}-${widths[Math.floor(widths.length / 2)]}.webp` : `${base}.webp`;
---
<picture class={cls}>
  <source type="image/avif" srcset={set("avif")} sizes={widths ? sizes : undefined} />
  <source type="image/webp" srcset={set("webp")} sizes={widths ? sizes : undefined} />
  <img src={fallback} width={width} height={height} alt={alt} loading={priority ? "eager" : loading} decoding="async" fetchpriority={priority ? "high" : undefined} />
</picture>

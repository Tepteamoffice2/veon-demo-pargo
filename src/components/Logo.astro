---
// Client logo: G sign (icon-512x512.png) + "ParGO" wordmark taken from about_logo.jpg (background removed, not redrawn).
const base = import.meta.env.BASE_URL;
---
<a class="logo" href="#top">
  <img class="logo__sign" src={`${base}images/g-sign-96.webp`} width="40" height="40" alt="" />
  <img class="logo__word" src={`${base}images/pargo-wordmark.webp`} width="121" height="24" alt="" />
  <span class="visually-hidden">ParGo, на початок сторінки</span>
</a>
